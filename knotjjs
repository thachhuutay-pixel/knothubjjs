        end
    elseif input.KeyCode == KeyLockClosest then
        lockClosestEnabled = not lockClosestEnabled
        if closestToggleUI then closestToggleUI.Set(lockClosestEnabled) end
        if not lockClosestEnabled then
            cachedClosestPlayer = nil
        end
    end
end)

-- --- RENDER LOOP (AUTO BLOCK & LOCK ON) ---
RunService.RenderStepped:Connect(function()
    local myChar = getValidCharacter(LocalPlayer)
    local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")

    -- 1. Auto Block Logic
    local autoBlockTarget = nil
    if autoBlockEnabled and myRoot then
        local charactersFolder = workspace:FindFirstChild("Characters")
        if charactersFolder then
            local shortestDist = autoBlockRange
            for _, model in ipairs(charactersFolder:GetChildren()) do
                if model:IsA("Model") then
                    local isLocalCharacter = (model == myChar)
                    if not isLocalCharacter then
                        local ownerCheck = Players:FindFirstChild(model.Name)
                        if ownerCheck == LocalPlayer then
                            isLocalCharacter = true
                        end
                    end

                    if not isLocalCharacter then
                        local rootPart = model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart or model:FindFirstChildOfClass("Part")
                        local hum = model:FindFirstChildOfClass("Humanoid")
                        local infoFolder = model:FindFirstChild("Info")
                        
                        if rootPart and hum and hum.Health > 0 and infoFolder and infoFolder:FindFirstChild("InSkill") then
                            local dist = (rootPart.Position - myRoot.Position).Magnitude
                            if dist <= shortestDist then
                                shortestDist = dist
                                autoBlockTarget = model
                            end
                        end
                    end
                end
            end
        end
    end

    if autoBlockTarget then
        setHoldF(true)
        local targetPart = autoBlockTarget:FindFirstChild("HumanoidRootPart") or autoBlockTarget.PrimaryPart or autoBlockTarget:FindFirstChildOfClass("Part")
        if targetPart then
            Camera.CFrame = CFrame.new(Camera.CFrame.Position, targetPart.Position)
        end
    else
        setHoldF(false)

        -- 2. Lock On thông thường khi không Auto Block
        if lockClosestEnabled and myRoot then
            local target = getClosestPlayer(myRoot)
            local targetChar = getValidCharacter(target)
            if targetChar and targetChar:FindFirstChild("HumanoidRootPart") then
                Camera.CFrame = CFrame.new(Camera.CFrame.Position, targetChar.HumanoidRootPart.Position)
            end
        elseif lockTargetEnabled and selectedTargetPlayer then
            local targetChar = getValidCharacter(selectedTargetPlayer)
            if targetChar and targetChar:FindFirstChild("HumanoidRootPart") then
                Camera.CFrame = CFrame.new(Camera.CFrame.Position, targetChar.HumanoidRootPart.Position)
            end
        end
    end

    updateAutoBlockZonePart()
end)

