-- --- HÀM LẤY NHÂN VẬT THẬT VÀ ĐANG HOẠT ĐỘNG CỦA PLAYER ---
local function getValidCharacter(player)
    if not player then return nil end
    
    local charactersFolder = workspace:FindFirstChild("Characters")
    if charactersFolder then
        for _, model in ipairs(charactersFolder:GetChildren()) do
            if model:IsA("Model") and model.Name == player.Name then
                local hum = model:FindFirstChildOfClass("Humanoid")
                local root = model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart
                if hum and root and hum.Health > 0 then
                    return model
                end
            end
        end
    end
    
    local char = player.Character
    if char and char:IsA("Model") then
        local hum = char:FindFirstChildOfClass("Humanoid")
        local root = char:FindFirstChild("HumanoidRootPart") or char.PrimaryPart
        if hum and root and hum.Health > 0 then
            return char
        end
    end
    
    return nil
end

-- --- FLY LOGIC ---
local function toggleFly(state)
    flyEnabled = state
    local char = getValidCharacter(LocalPlayer)
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end

    if flyEnabled then
        local root = char.HumanoidRootPart
        bodyVelocity = Instance.new("BodyVelocity")
        bodyVelocity.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
        bodyVelocity.Velocity = Vector3.new(0,0,0)
        bodyVelocity.Parent = root

        bodyGyro = Instance.new("BodyGyro")
        bodyGyro.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
        bodyGyro.CFrame = root.CFrame
        bodyGyro.Parent = root

        task.spawn(function()
            while flyEnabled do
                RunService.RenderStepped:Wait()
                local currentLocalChar = getValidCharacter(LocalPlayer)
                if not currentLocalChar or not currentLocalChar:FindFirstChild("HumanoidRootPart") then break end
                local camCF = Camera.CFrame
                local dir = Vector3.new(0, 0, 0)
                
                if UserInputService:IsKeyDown(Enum.KeyCode.W) then dir = dir + camCF.LookVector end
                if UserInputService:IsKeyDown(Enum.KeyCode.S) then dir = dir - camCF.LookVector end
                if UserInputService:IsKeyDown(Enum.KeyCode.A) then dir = dir - camCF.RightVector end
                if UserInputService:IsKeyDown(Enum.KeyCode.D) then dir = dir + camCF.RightVector end

                bodyVelocity.Velocity = dir * flySpeed
                bodyGyro.CFrame = camCF
            end
        end)
    else
        if bodyVelocity then bodyVelocity:Destroy() end
        if bodyGyro then bodyGyro:Destroy() end
    end
end

-- --- HÀM TÌM GẦN NHẤT 3D CHUẨN XÁC ---
local function getClosestPlayer(myRoot)
    local target = nil
    local shortestDist = math.huge

    if cachedClosestPlayer and cachedClosestPlayer ~= LocalPlayer then
        local oldChar = getValidCharacter(cachedClosestPlayer)
        if oldChar and oldChar:FindFirstChild("HumanoidRootPart") then
            local dist = (oldChar.HumanoidRootPart.Position - myRoot.Position).Magnitude
            if dist <= 35 then
                shortestDist = dist + 6
                target = cachedClosestPlayer
            end
        end
    end

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local char = getValidCharacter(player)
            if char and char:FindFirstChild("HumanoidRootPart") then
                local dist = (char.HumanoidRootPart.Position - myRoot.Position).Magnitude
                if dist < shortestDist then
                    shortestDist = dist
                    target = player
                end
            end
        end
    end

    cachedClosestPlayer = target
    return target
end

-- --- XỬ LÝ GIỮ PHÍM F ---
local function setHoldF(state)
    pcall(function()
        if state and not isHoldingF then
            isHoldingF = true
            VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.F, false, game)
        elseif not state and isHoldingF then
            isHoldingF = false
            VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.F, false, game)
        end
    end)
end

