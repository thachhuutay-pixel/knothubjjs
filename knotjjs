-- 4. ESP SYSTEM (TIÊU CHUẨN + onScreen CHECK)
-- ==========================================
local espBoxEnabled = false
local espTracerEnabled = false
local espSkeletonEnabled = false
local espInfoEnabled = false
local espItemsEnabled = false

local espDrawings = {}
local itemDrawings = {}
local itemHighlights = {}

local function createESP(player)
    if player == LocalPlayer or espDrawings[player] then return end
    espDrawings[player] = {
        Box = Drawing.new("Square"),
        Tracer = Drawing.new("Line"),
        InfoText = Drawing.new("Text"),
        HeadToTorso = Drawing.new("Line"),
        TorsoToLeftArm = Drawing.new("Line"),
        TorsoToRightArm = Drawing.new("Line"),
        TorsoToLeftLeg = Drawing.new("Line"),
        TorsoToRightLeg = Drawing.new("Line")
    }
    local d = espDrawings[player]
    d.Box.Color = Color3.fromRGB(255, 150, 200)
    d.Box.Thickness = 1.5
    d.Box.Filled = false
    d.Tracer.Color = Color3.fromRGB(255, 105, 180)
    d.Tracer.Thickness = 1
    d.InfoText.Size = 13
    d.InfoText.Center = true
    d.InfoText.Outline = true
    d.InfoText.Color = Color3.fromRGB(255, 255, 255)
end

local function removeESP(player)
    if espDrawings[player] then
        for _, obj in pairs(espDrawings[player]) do
            pcall(function() obj:Remove() end)
        end
        espDrawings[player] = nil
    end
end

Players.PlayerAdded:Connect(createESP)
Players.PlayerRemoving:Connect(removeESP)
for _, p in ipairs(Players:GetPlayers()) do createESP(p) end

RunService.RenderStepped:Connect(function()
    local myChar = getValidCharacter(LocalPlayer)
    local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")

    -- 1. Player ESP Render
    for player, drawings in pairs(espDrawings) do
        local char = getValidCharacter(player)
        local root = char and char:FindFirstChild("HumanoidRootPart")
        local hum = char and char:FindFirstChildOfClass("Humanoid")

        if char and root and hum and hum.Health > 0 and myRoot then
            local pos, onScreen = Camera:WorldToViewportPoint(root.Position)

            if espBoxEnabled and onScreen then
                local sizeY = (Camera:WorldToViewportPoint(root.Position - Vector3.new(0, 3, 0)).Y - Camera:WorldToViewportPoint(root.Position + Vector3.new(0, 3, 0)).Y)
                local boxSize = Vector2.new(math.abs(sizeY) * 0.6, math.abs(sizeY))
                drawings.Box.Size = boxSize
                drawings.Box.Position = Vector2.new(pos.X - boxSize.X / 2, pos.Y - boxSize.Y / 2)
                drawings.Box.Visible = true
            else
                drawings.Box.Visible = false
            end

            if espTracerEnabled and onScreen then
                drawings.Tracer.From = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
                drawings.Tracer.To = Vector2.new(pos.X, pos.Y)
                drawings.Tracer.Visible = true
            else
                drawings.Tracer.Visible = false
            end

            if espInfoEnabled and onScreen then
                local dist = math.floor((root.Position - myRoot.Position).Magnitude)
                local health = math.floor(hum.Health)
                local maxHealth = math.floor(hum.MaxHealth)
                drawings.InfoText.Text = string.format("%s\n[HP: %d/%d] [%dm]", player.DisplayName, health, maxHealth, dist)
                drawings.InfoText.Position = Vector2.new(pos.X, pos.Y - 45)
                drawings.InfoText.Visible = true
            else
                drawings.InfoText.Visible = false
            end

            if espSkeletonEnabled and onScreen then
                local head = char:FindFirstChild("Head")
                local torso = char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso")
                local lArm = char:FindFirstChild("LeftUpperArm") or char:FindFirstChild("Left Arm")
                local rArm = char:FindFirstChild("RightUpperArm") or char:FindFirstChild("Right Arm")
                local lLeg = char:FindFirstChild("LeftUpperLeg") or char:FindFirstChild("Left Leg")
                local rLeg = char:FindFirstChild("RightUpperLeg") or char:FindFirstChild("Right Leg")

                local function connectBone(line, p1, p2)
                    if p1 and p2 then
                        local pos1, vis1 = Camera:WorldToViewportPoint(p1.Position)
                        local pos2, vis2 = Camera:WorldToViewportPoint(p2.Position)
                        if vis1 and vis2 then
                            line.From = Vector2.new(pos1.X, pos1.Y)
                            line.To = Vector2.new(pos2.X, pos2.Y)
                            line.Visible = true
                            return
                        end
                    end
                    line.Visible = false
                end

                connectBone(drawings.HeadToTorso, head, torso)
                connectBone(drawings.TorsoToLeftArm, torso, lArm)
                connectBone(drawings.TorsoToRightArm, torso, rArm)
                connectBone(drawings.TorsoToLeftLeg, torso, lLeg)
                connectBone(drawings.TorsoToRightLeg, torso, rLeg)
            else
                drawings.HeadToTorso.Visible = false
                drawings.TorsoToLeftArm.Visible = false
                drawings.TorsoToRightArm.Visible = false
                drawings.TorsoToLeftLeg.Visible = false
                drawings.TorsoToRightLeg.Visible = false
            end
        else
            for _, obj in pairs(drawings) do obj.Visible = false end
        end
    end

    -- 2. Items ESP Render (Workspace.Items)
    local itemsFolder = workspace:FindFirstChild("Items")
    if espItemsEnabled and itemsFolder then
        local currentItems = {}
        for _, item in ipairs(itemsFolder:GetChildren()) do
            currentItems[item] = true
            
            if not itemDrawings[item] then
                itemDrawings[item] = Drawing.new("Text")
                itemDrawings[item].Size = 13
                itemDrawings[item].Center = true
                itemDrawings[item].Outline = true
                itemDrawings[item].Color = Color3.fromRGB(255, 215, 0)
            end

            if not itemHighlights[item] and item:IsA("Instance") then
                local highlight = Instance.new("Highlight")
                highlight.Name = "ItemESPんですよ"
                highlight.Adornee = item
                highlight.FillColor = Color3.fromRGB(255, 215, 0)
                highlight.FillTransparency = 0.5
                highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
                highlight.OutlineTransparency = 0
                highlight.Parent = item
                itemHighlights[item] = highlight
            end

            local part = item:IsA("Model") and (item.PrimaryPart or item:FindFirstChildWhichIsA("BasePart")) or (item:IsA("BasePart") and item)
            if part then
                local pos, onScreen = Camera:WorldToViewportPoint(part.Position)
                local dist = myRoot and math.floor((part.Position - myRoot.Position).Magnitude) or 0
                if onScreen then
                    itemDrawings[item].Text = string.format("%s [%dm]", item.Name, dist)
                    itemDrawings[item].Position = Vector2.new(pos.X, pos.Y)
                    itemDrawings[item].Visible = true
                else
                    itemDrawings[item].Visible = false
                end
            else
                itemDrawings[item].Visible = false
            end
        end

        for item, drawing in pairs(itemDrawings) do
            if not currentItems[item] then
                pcall(function() drawing:Remove() end)
                itemDrawings[item] = nil
                if itemHighlights[item] then
                    pcall(function() itemHighlights[item]:Destroy() end)
                    itemHighlights[item] = nil
                end
            end
        end
    else
        for _, drawing in pairs(itemDrawings) do
            drawing.Visible = false
        end
        for _, hl in pairs(itemHighlights) do
            if hl then hl:Destroy() end
        end
        itemHighlights = {}
    end
end)

